# Copia este archivo como .env para correr en tu computadora. NUNCA subas el .env a GitHub.
# En Cloud Run estas variables se ponen como secretos (ver README).

# dev = permite /prueba sin token en tu computadora
ENTORNO=dev

# Gemini (https://aistudio.google.com/apikey). Sin llave, el bot corre en "modo sin IA" (no lee fotos).
GEMINI_API_KEY=
MODELO_CHAT=gemini-3.8-flash
MODELO_VISION=gemini-3.8-flash

# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp)
META_APP_SECRET=
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=inventa-una-frase-larga
META_GRAPH_VERSION=v20.0
# Piloto: solo estos números (código de país 503 + número, separados por coma). Vacío = cualquiera.
NUMEROS_PERMITIDOS=

# Chat de prueba en el navegador: https://TU-URL/prueba?t=ESTE_TOKEN
PRUEBA_TOKEN=
# URL pública del servicio (para mandar enlaces de descarga si WhatsApp rechaza un archivo)
URL_PUBLICA=
